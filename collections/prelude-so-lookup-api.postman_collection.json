                  "value": "<string>",
                  "description": "Optional lookup features to include. Currently supports `cnam` to retrieve the caller ID name (requires enablement on your account)."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Optional lookup features to include. Currently supports `cnam` to retrieve the caller ID name (requires enablement on your account)."
