            "description": {
              "content": "Returns intelligence about a phone number - line type, current and original carrier (network) info, ported / temporary flags, and optionally the caller name (CNAM). Useful for number validation and anti-fraud enrichment.",
              "type": "text/plain"
            },
            "url": {
