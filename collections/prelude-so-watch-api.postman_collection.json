          "request": {
            "name": "Predict signup risk",
            "description": {
              "content": "Scores a signup identifier (phone number or email address) as `legitimate` or `suspicious`, optionally using anti-fraud signals such as IP, device id, and device platform, plus a frontend SDK dispatch id.",
